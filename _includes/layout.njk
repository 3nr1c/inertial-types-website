<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Inertial Types") }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <script>
    window.MathJax = {
        tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']],
            displayMath: [['$$', '$$'], ['\\[', '\\]']],
            // This tells MathJax to allow breaks after binary operators and relations
            processEscapes: true
        },
        chtml: {
            displayAlign: 'left',
            linebreaks: { 
                inline: true, 
                width: 'container'
            }
        },
        // Adding this ensures that the internal TeX engine allows the break
        options: {
            enableMenu: false
        }
    };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

    <style>
        /* Force the container to respect the parent width */
        .bg-light.px-2.py-1.rounded {
            display: inline-block; /* Allows the span to act like a block for wrapping */
            max-width: 100%;
            overflow-x: auto;      /* Adds scrollbar if wrapping fails */
            overflow-y: hidden;
            vertical-align: middle;
            white-space: normal;   /* Crucial for allowing text wrap */
        }

        /* Force MathJax output to wrap */
        mjx-container[jax="CHTML"][display="true"] {
            display: block;
            overflow-x: auto;
            overflow-y: hidden;
            max-width: 100%;
        }

        mjx-c {
            white-space: normal !important;
        }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="{{ project.baseurl }}">Inertial Types</a>
        </div>
    </nav>
    
    <main class="container">
        {{ content | safe }}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const copyButtons = document.querySelectorAll('.copy-poly-btn');
        
        copyButtons.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                // Prevent link navigation if the button is inside an <a> tag (like on index.njk)
                e.preventDefault(); 
                e.stopPropagation(); 
                
                const polyText = btn.getAttribute('data-poly');
                
                try {
                    await navigator.clipboard.writeText(polyText);
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = 'Copied!';
                    btn.classList.add('btn-success', 'text-white');
                    btn.classList.remove('btn-outline-secondary');
                    
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.classList.remove('btn-success', 'text-white');
                        btn.classList.add('btn-outline-secondary');
                    }, 1500);
                } catch (err) {
                    console.error('Failed to copy', err);
                }
            });
        });
    });
</script>
</body>
</html>
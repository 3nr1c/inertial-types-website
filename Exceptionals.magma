Q2:=pAdicField(2,50);
F:=UnramifiedExtension(Q2,2);
L:=FieldOfFractions(AllExtensions(F,3)[1]);
R<X> := PolynomialRing(L);

GSel, Sel, SeltoL, Gal, GaltoAut := SelmerGaloisModule(F,L);
sigma := GaltoAut(Gal.2);

p, ram_deg, in_deg, pi, N := BaseValues(L);
ff := Floor(N/2);
UGroups, UMaps, ULift := UComplex(L, ff);

SelOrbits := {M: M in MinimalSubmodules(GSel) | Dimension(M) eq 2};

for orbit in SelOrbits do
    Polynomials := [];
    roots := [];
    for v in orbit do
        if v eq 0 then continue; end if;
        z := ChangePrecision(SeltoL(Sel!ElementToSequence(GSel!v)), Precision(L));
        Append(~Polynomials, X^2 - z);
    end for;

    KFields := [];
    OKRings := [];
    EFields := [];
    for i in [1 .. 3] do
        K, r := SplittingField(Polynomials[i]);
        OK := Integers(K);
        S<Y> := PolynomialRing(K);

        j := i lt 3 select i + 1 else 1; 
        E, s := SplittingField(S!Polynomials[j]);
        Append(~KFields, K);
        Append(~OKRings, OK);
        Append(~EFields, E);
    end for;
        // Append(~roots, r[1]);
        // Append(~InductionFields, K);
    // InductionFields;

    AllCGroups := [* *];
    AllCMaps := [* *];
    AllCLifts := [* *];
    i := 1;
    for K in KFields do
        // f, c, VarepsGenerators := GetVarepsilonGenerators(L, K : MyComplex:=[*UGroups, UMaps, ULift*]);
        i;

        // if i eq 1 then
            Chars, CGroups, CMaps, CLift := SupercuspidalRamified2withoutArgs(L,K);
        // else 
            // CGroups, CMaps, CLift := ConComplex(L, K, f);
        // end if;
        #Chars;
        Append(~AllCGroups, CGroups);
        Append(~AllCMaps, CMaps);
        Append(~AllCLifts, CLift);

        i +:= 1;
        // #Chars;
    end for; 

    // barsigma := [*
    //     AllCLifts[1] * sigma * Inverse(AllCLifts[2]),
    //     AllCLifts[2] * sigma * Inverse(AllCLifts[3]),
    //     AllCLifts[3] * sigma * Inverse(AllCLifts[1])
    // *];


    break;
end for;

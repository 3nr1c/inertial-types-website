//This function produces the 2-Selmer Group of L as a Gal(L/F) module
function SelmerGaloisModule (F,L)
    assert IsNormal(L,F);
    F2:=GF(2);
    Gal,GaltoAut:=AutomorphismGroup(L,F);
    Sel,LtoSel:=pSelmerGroup(2,L);
    n:=#Generators(Sel);
    Operators:=[ScalarMatrix(GF(2),n,1)];
    ListOfGens := [Sel.i : i in [1 .. n]];

    for t in Generators(Gal) do
        M:=[];
        g:=GaltoAut(t);

        for z in ListOfGens do
            y:=ChangePrecision(Inverse(LtoSel)(z),Precision(L));
            M:=Append(M,ElementToSequence(LtoSel(g(y))));
        end for;
        Operators:=Append(Operators,Matrix(F2,M));
    end for;
    GSel:=GModule(Gal,Operators);
    return GSel,Gal,Operators;
end function;


Q2:=pAdicField(2,300);
Q4:=UnramifiedExtension(Q2,2);
for i in [1..4] do
K:=FieldOfFractions(AllExtensions(Q4,3)[i]);
GSel,Gal,Operators:=SelmerGaloisModule(Q4,K);
{M: M in MinimalSubmodules(GSel) | Dimension(M) eq 2};
print("--------------------------------------------------");
end for;

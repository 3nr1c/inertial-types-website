// This is a Demo for Enric to know what we need
Z:=Integers();

function BaseValues(F)
p:=Prime(F);
e:=AbsoluteRamificationDegree(F);
f:=AbsoluteInertiaDegree(F);
N:=Z!(6*Valuation(F!2)+3*Valuation(F!3)+2);
F2:=ChangePrecision(F,N);
UnitGroup(Integers(F2));
return p,e,f,N;
end function;

function ExtValues(F,K)
pi:=UniformizingElement(K);
Cond:=Valuation(Discriminant(K,F));
Gal:=Automorphisms(K,F);
y:=pi/Gal[2](pi);
return Cond,pi,Gal,y;
end function;

function QuadraticExtensions(F)
Fx<x>:=PolynomialRing(F);
Sel,f:=pSelmerGroup(2,F);
QuadExt:=[];
QuadGen:=[];
for z in Sel do
z1:=ChangePrecision(Inverse(f)(z),Precision(F));
QuadGen:=Append(QuadGen,z1);
QuadExt:=Append(QuadExt,SplittingField(x^2-z1));
end for;
return QuadExt,QuadGen,Sel,f;
end function;

function ConGroup(K,f)
K:=ChangePrecision(K,f);
OK:=Integers(K);
UK,mK:=UnitGroup(OK);
Uf:=sub<UK|[Inverse(mK)(OK!Norm(mK(g))) : g in Generators(UK)]>;
ConG,ConGtoUK:=quo<UK|Uf>;
return ConG,ConGtoUK,UK,mK;
end function;


function ConGMap(K,f)

K1:=ChangePrecision(K,f);
OK1:=Integers(K1);
UK1,mK1:=UnitGroup(OK1);
Uf1:=sub<UK1|[Inverse(mK1)(OK1!Norm(mK1(g))) : g in Generators(UK1)]>;
G1,U1toG1:=quo<UK1|Uf1>;
Lift:=Inverse(U1toG1)*mK1*Coercion(OK1,K1)*Coercion(K1,K);



K2:=ChangePrecision(K,f-1);
OK2:=Integers(K2);
UK2,mK2:=UnitGroup(OK2);
Uf2:=sub<UK2|[Inverse(mK2)(OK2!Norm(mK2(g))) : g in Generators(UK2)]>;
G2,U2toG2:=quo<UK2|Uf2>;

L:=[];

for g in Generators(G1) do
L:=Append(L,<g, U2toG2(Inverse(mK2)(K2!(Lift(g)))) >);
end for;

phi:=hom<G1->G2|L>;
return G1,G2,phi,Lift;
end function;



function ConComplex(K,f)

CGroups:=[];
CMaps:=[* *];


K1:=ChangePrecision(K,f);
OK1:=Integers(K1);
UK1,mK1:=UnitGroup(OK1);
Uf1:=sub<UK1|[Inverse(mK1)(OK1!Norm(mK1(g))) : g in Generators(UK1)]>;
G1,U1toG1:=quo<UK1|Uf1>;
Lift:=Inverse(U1toG1)*mK1*Coercion(OK1,K1)*Coercion(K1,K);

CGroups:=Append(CGroups,G1);

for i in [1..f-3] do  //The f-3 there need to be replace by a sharp value depending on the field but for now is enough
K2:=ChangePrecision(K,f-i);
OK2:=Integers(K2);
UK2,mK2:=UnitGroup(OK2);
Uf2:=sub<UK2|[Inverse(mK2)(OK2!Norm(mK2(g))) : g in Generators(UK2)]>;
G2,U2toG2:=quo<UK2|Uf2>;

CGroups:=Append(CGroups,G2);

L:=[];
for g in Generators(G1) do
L:=Append(L,<g, U2toG2(Inverse(mK2)(K2!(K1!mK1(Inverse(U1toG1)(g))))) >);
end for;

phi:=hom<G1->G2|L>;
CMaps:=Append(CMaps,phi);

K1:=K2;
OK1:=OK2;
UK1:=UK2;
mK1:=mK2;
Uf1:=Uf2;
G1:=G2;
U1toG1:=U2toG2;
end for;

return CGroups,CMaps,Lift;
end function;

//The idea of the function ConComplex is to be able to do, for example, the following

Q2:=pAdicField(2,100);
K:=FieldOfFractions(AllExtensions(Q2,2)[3]);
Groups,Maps,Lift:=ConComplex(K,7);
Lift(Groups[1].1);
Maps[4](Maps[3](Maps[2](Maps[1](Groups[1].2))));
Maps[2](Groups[2].1);




---
layout: layout.njk
pagination:
  data: fields
  size: 1
  alias: field
  resolve: values
permalink: "fields/{{ field.label | slugify }}/"
eleventyComputed:
  title: "Inertial Types | {{ field.label }}"
---

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h1 class="card-title text-primary">{{ field.label }}</h1>
        <p class="lead mt-3 mb-1 d-flex align-items-center">
            <strong>Defining Polynomial:</strong> 
            <span class="h5 bg-light px-2 py-1 rounded mb-0 ms-2">\( {{ field.polynomial | formatMath }} \)</span>
            <button class="btn btn-sm btn-outline-secondary ms-3 copy-poly-btn" data-poly="{{ field.polynomial }}" title="Copy raw polynomial">Copy</button>
        </p>
        {% if field.lmfdb_url %}
        <p class="mb-0">
            <a href="{{ field.lmfdb_url }}" target="_blank" rel="noopener noreferrer" class="link-secondary text-decoration-none border-bottom border-secondary" style="font-size: 0.95rem;">
                View field on LMFDB &nearr;
            </a>
        </p>
        {% endif %}
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h3 class="h5 mb-0 py-1">Summary table</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>e</th>
                    <th>v(N)</th>
                    <th>Character Order</th>
                    <th>Description</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                {% for row in field.table %}
                <tr>
                    <td>{{ row.e }}</td>
                    <td>{{ row["v(N)"] }}</td>
                    <td>{{ row["character order"] }}</td>
                    <td>{{ row.description }}</td>
                    <td>{{ row.count }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">No summary data available for this field.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h3 class="h5 mb-0 py-1">Inertial Types</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>e</th>
                    <th>v(N)</th>
                    <th>Character Order</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                {% set hasTypes = false %}
                
                {% for type in typePages %}
                    {% if type["Base Field"] == field.label %}
                        {% set hasTypes = true %}
                        <tr>
                            <td>
                                <a href="/types/{{ type.id | slugify }}/" class="text-decoration-none fw-semibold">
                                    {{ type.Name }}
                                </a>
                            </td>
                            <td>{{ type.e }}</td>
                            <td>{{ type["v(N)"] }}</td>
                            <td>{{ type["Character Order"] }}</td>
                            <td>{{ type.Description }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}

                {% if not hasTypes %}
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">No individual inertial types found for this field.</td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 mb-5">
    <a href="/" class="btn btn-outline-secondary">&larr; Back to Directory</a>
</div>
function BaseValues(F)
Z:=Integers();
p:=Prime(F);
e:=AbsoluteRamificationDegree(F);
f:=AbsoluteInertiaDegree(F);
N:=Z!(6*Valuation(F!2)+3*Valuation(F!3)+2);
return p,e,f,N;
end function;

//Dont worry if you dont have time to read these, I will Explain everything to you on monday I think it is faster that way.
// Note that thise file is devoted to compute the complex of Unit groups before taking the quotient by Uf.
// Once this is done it is enough to compute the Uf for the highest group and quotient by the images.
// Is better to do it this way because for the principal series we need the UComplex rather than the ConComplex.


// This function compute Ugroups for higher values of f
function HigherUComplex(K,f)
p,e:=BaseValues(K);
CGroups:=[];
CMaps:=[* *];

K1:=ChangePrecision(K,f);
OK1:=Integers(K1);
UK1,mK1:=UnitGroup(OK1);
Uf1:=sub<UK1|[Inverse(mK1)(OK1!Norm(mK1(g))) : g in Generators(UK1)]>;
Lift:=mK1*Coercion(OK1,K1)*Coercion(K1,K);
CGroups:=Append(CGroups,UK1);

for i in [1..f-e-1] do
K2:=ChangePrecision(K,f-i);
OK2:=Integers(K2);
UK2,mK2:=UnitGroup(OK2);

L:=[];
for g in Generators(UK1) do
L:=Append(L,<g,Inverse(mK2)(K2!(K1!mK1((g))))>);
end for;

phi:=hom<UK1-> UK2|L>;

CGroups:=Append(CGroups,UK2);
CMaps:=Append(CMaps,phi);
K1:=K2;
OK1:=OK2;
UK1:=UK2;
mK1:=mK2;
end for;

return CGroups,CMaps,Lift;
end function;


//I made this function to check if I was able to compute te lower UGroups I keep it just in case.
function LowUComplex(K)
Groups:=[];
Maps:=[* *];
Lifts:=[* *];
p,e,f,N:=BaseValues(K);
K1:=ChangePrecision(K);
OK1:=Integers(K1);
UK1,mK1:=UnitGroup(OK1);
Uf1:=sub<UK1|[Inverse(mK1)(OK1!Norm(mK1(g))) : g in Generators(UK1)]>;
Lift:=mK1*Coercion(OK1,K1)*Coercion(K1,K);

Groups:=Append(Groups,UK1);
Lifts:=Append(Lifts,Lift);

for i in [1..e] do
    L:=[];
    for g in Groups[i] do
            t:=ChangePrecision((Lifts[i])(g),Precision(K));
            if Valuation(t-1) ge e+1-i then L:=Append(L,g); end if;
            if #L eq 2^f then break; end if;
    end for;
    U,phi:=quo<Groups[i]|L>;
    Groups:=Append(Groups,U);
    if i gt 1 then q:=Maps[i-1]*phi; else q:=phi;  end if;
    Maps:=Append(Maps,q);
    Lifts:=Append(Lifts,Inverse(q)*Lifts[1]);
end for;

return Groups,Maps,Lifts;
end function;


// This function merge the faster approach for the higher values of f with the slower approach needed for the lower values of f.
// I check it with large extensions and it gives consistent results.

// I made it so that Maps[i] goes from Group[1] to Group[i+1] instead of going from Group[i] to Group[i+1].
// we can maybe define Maps[1] to be the identity so that Maps[i] goes from Groups[1] to Groups[i]. 
function UComplex(K,f)
p,e:=BaseValues(K);
UGroups:=[];
UMaps:=[* *];

K1:=ChangePrecision(K,f);
OK1:=Integers(K1);
UK1,mK1:=UnitGroup(OK1);
Uf1:=sub<UK1|[Inverse(mK1)(OK1!Norm(mK1(g))) : g in Generators(UK1)]>;
Lift:=mK1*Coercion(OK1,K1)*Coercion(K1,K);
UGroups:=Append(UGroups,UK1);

for i in [1..f-1] do
    if i le f-e-1 then
        K2:=ChangePrecision(K,f-i);
        OK2:=Integers(K2);
        UK2,mK2:=UnitGroup(OK2);

        L:=[];
        for g in Generators(UK1) do
            L:=Append(L,<g,Inverse(mK2)(K2!(K1!mK1((g))))>);
        end for;

        phi:=hom<UK1-> UK2|L>;
        if i gt 1 then q:=UMaps[i-1]*phi; else q:=phi;  end if;
        UGroups:=Append(UGroups,UK2);
        UMaps:=Append(UMaps,q);
        K1:=K2;
        OK1:=OK2;
        UK1:=UK2;
        mK1:=mK2;
    else
        L:=[];
        for g in UGroups[i] do
                t:=ChangePrecision((Inverse(UMaps[i-1])*Lift)(g),Precision(K));
                if Valuation(t-1) ge f-i then L:=Append(L,g); end if;
                if #L eq 2^f then break; end if;
        end for;
        U,phi:=quo<UGroups[i]|L>;
        UGroups:=Append(UGroups,U);
        q:=UMaps[i-1]*phi;
        UMaps:=Append(UMaps,q);
    end if;
end for;
    

return UGroups,UMaps,Lift;
end function;